    justifyContent: "space-between",
    overflow: "hidden",
  },
  cardTop: {
    gap: 12,
  },
  cardTitle: {
    fontSize: 32,
    fontWeight: "800",
    color: "#FFFFFF",
    fontFamily: fontFamily.Paprika,
  },
  cardDescription: {
    fontSize: 12,
    color: "rgba(255,255,255,0.75)",
    lineHeight: 18,
    fontFamily: fontFamily.medium,
  },
  cardCenter: {
    flex: 1,
    justifyContent: "center",
    alignItems: "center",
  },
  iconContainer: {
    width: 180,
    height: 180,
    justifyContent: "center",
    alignItems: "center",
  },

  // AR viewfinder
  arIconBox: {
    width: 160,
    height: 160,
    justifyContent: "center",
    alignItems: "center",
    position: "relative",
  },
  corner: {
    position: "absolute",
    width: CORNER_SIZE,
    height: CORNER_SIZE,
    borderColor: "rgba(255,255,255,0.8)",
  },
  topLeft: {
    top: 0,
    left: 0,
    borderTopWidth: CORNER_BORDER,
