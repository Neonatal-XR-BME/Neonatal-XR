<file path="components/temperature-bar.tsx">
import { CORE_RANGE } from "@/lib/parameter-state";
import React from "react";
import { StyleSheet, View } from "react-native";

/**
 * TemperatureBar
 *
 * Fills proportionally across [rangeMin, rangeMax] and colors the fill by how
 * far the value sits from the expected (clinical) band [normalMin, normalMax]:
 *   - green  : within the normal band
 *   - yellow : outside the band but by <= tolerance
 *   - red    : outside the band by more than tolerance
 *
 * rangeMin/rangeMax control the visual fill (e.g. core 34 -> set target,
 * ambient 20 -> 26). normalMin/normalMax control the color only.
 */

const COLOR_NORMAL = "#0AC084"; // green
const COLOR_WARN = "#FBEC47"; // yellow
const COLOR_ALERT = "#FF5252"; // red

const BAR_HEIGHT = 24;
const BAR_RADIUS = 6;

export interface TemperatureBarProps {
  temperature: number;
  rangeMin?: number;
  rangeMax?: number;
  normalMin?: number;
  normalMax?: number;
  tolerance?: number;
}

export function colorForTemperature(
  temperature: number,
  normalMin: number,
  normalMax: number,
  tolerance: number
): string {
  if (temperature >= normalMin && temperature <= normalMax) {
    return COLOR_NORMAL;
  }
  const deviation =
    temperature < normalMin ? normalMin - temperature : temperature - normalMax;
  return deviation <= tolerance ? COLOR_WARN : COLOR_ALERT;
}

export function fillPercent(
  temperature: number,
  rangeMin: number,
  rangeMax: number
): number {
  if (rangeMax <= rangeMin) return 0;
  const pct = ((temperature - rangeMin) / (rangeMax - rangeMin)) * 100;
  return Math.max(0, Math.min(100, pct));
}

export default function TemperatureBar({
  temperature,
  rangeMin = 34,
  rangeMax = 37.5,
  normalMin = CORE_RANGE.min,
  normalMax = CORE_RANGE.max,
  tolerance = 0.2,
}: TemperatureBarProps) {
  const color = colorForTemperature(
    temperature,
    normalMin,
    normalMax,
    tolerance
  );
  const width = fillPercent(temperature, rangeMin, rangeMax);

  return (
    <View style={styles.track}>
      <View
        style={[styles.fill, { backgroundColor: color, width: `${width}%` }]}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  track: {
    width: "100%",
    height: BAR_HEIGHT,
    borderRadius: BAR_RADIUS,
    backgroundColor: "#EEEEEE",
    overflow: "hidden",
  },
  fill: {
    height: "100%",
    borderRadius: BAR_RADIUS,
  },
});
</file>

<file path="components/vr-room-scene.tsx">
import {
  Viro360Image,
  Viro3DObject,
  ViroAmbientLight,
  ViroNode,
  ViroQuad,
  ViroScene,
  ViroSpotLight,
  ViroText,
} from "@reactvision/react-viro";
import React, { useState } from "react";

// Degrees the model turns per click.
const STEP = 30;

/**
 * Gaze-controlled VR room scene for Google Cardboard / Shinecon (Android GVR).
 *
 * Interaction model: the user looks at a floating arrow (gaze) and presses the
 * Bluetooth remote, which Android delivers as a mouse click and Viro surfaces
 * as onClick — the same path as the Cardboard trigger. Each arrow rotates the
 * warmer about an axis. A small center reticle shows the gaze point.
 *
 * Why gaze + click and not direct remote-to-rotation: the remote only emits
 * BTN_MOUSE (a click), no directional/movement events, so direction comes from
 * where the user looks, and the click commits the rotation.
 */

type Axis = "x" | "y";

function ArrowTarget({
  label,
  position,
  onPress,
}: {
  label: string;
  position: [number, number, number];
  onPress: () => void;
}) {
  const [hovered, setHovered] = useState(false);

  return (
    <ViroNode position={position}>
      {/* Invisible-ish backing quad gives a comfortable gaze/click area */}
      <ViroQuad
        height={0.5}
        width={0.5}
        materials={hovered ? ["arrowActive"] : ["arrowIdle"]}
        onHover={(isHovering: boolean) => setHovered(isHovering)}
        onClick={() => onPress()}
      />
      <ViroText
        text={label}
        position={[0, 0, 0.01]}
        scale={[0.5, 0.5, 0.5]}
        style={{
          fontSize: 36,
          color: hovered ? "#FFD60A" : "#FFFFFF",
          fontWeight: "bold",
          textAlign: "center",
        }}
        outerStroke={{ type: "Outline", width: 2, color: "#000000" }}
      />
    </ViroNode>
  );
}

export default function VRRoomScene() {
  const [rotX, setRotX] = useState(0);
  const [rotY, setRotY] = useState(0);

  const rotate = (axis: Axis, dir: number) => {
    if (axis === "x") setRotX((r) => r + dir * STEP);
    else setRotY((r) => r + dir * STEP);
  };

  return (
    <ViroScene>
      <Viro360Image source={require("@/assets/models/hospital_room.jpg")} />
      <ViroAmbientLight color="#FFFFFF" intensity={500} />
      <ViroSpotLight
        position={[0, 5, 0]}
        direction={[0, -1, 0]}
        color="#ffffff"
        intensity={800}
      />

      {/* Warmer model, rotated by gaze+click */}
      <ViroNode position={[0, -0.5, -2]} rotation={[rotX, rotY, 0]}>
        <Viro3DObject
          source={require("@/assets/models/3D/nooosi.glb")}
          type="GLB"
          scale={[0.002, 0.002, 0.002]}
          position={[0, -0.9, 0.7]}
          onError={(e: any) => console.error("VR model error:", e)}
        />
      </ViroNode>

      {/* Arrow controls around the model */}

      {/* Center gaze reticle: a small dot fixed in front of the camera */}
      <ViroNode position={[0, 0, -1]}>
        <ViroQuad height={0.015} width={0.015} materials={["reticle"]} />
      </ViroNode>
    </ViroScene>
  );
}
</file>

